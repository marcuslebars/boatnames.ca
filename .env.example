# Holy Ship — environment variables.
# Copy to `.env` for local dev. NEVER commit real values.
#
# RULE: anything prefixed VITE_ is PUBLIC — Vite inlines it into the browser
# bundle. Secrets (service-role key, Resend key, EmpireVu secret, database URL)
# MUST NOT carry the VITE_ prefix.

# ─── Public (VITE_*) — shipped to the browser ────────────────────────────────
# Canonical site origin. Drives absolute OG images, the sitemap, and the
# shareable preview links. Defaults to https://holyship.a1marinecare.ca.
VITE_SITE_URL=
# Optional. If set, client-side errors are POSTed here ({message,stack,route,userAgent}).
VITE_ERROR_ENDPOINT=

# ─── Supabase (SERVER-ONLY) ──────────────────────────────────────────────────
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service-role key — bypasses RLS. Used ONLY by the /api/quote server route.
# SECRET. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Private Storage bucket for transom photos (default: quote-photos).
QUOTE_PHOTO_BUCKET=quote-photos

# ─── Outbound email — Resend (SERVER-ONLY) ───────────────────────────────────
# If unset, the lead is still saved; the notification is just skipped.
RESEND_API_KEY=
# From address (must be a Resend-verified domain).
LEAD_FROM_EMAIL=leads@a1marinecare.ca
# Internal recipient of the lead notification.
LEAD_NOTIFY_EMAIL=hello@a1marinecare.ca

# ─── EmpireVu forward (SERVER-ONLY) — GATED OFF by default ───────────────────
# The signed lead forward to EmpireVu's /api/intake. Holy Ship is the 4th spoke.
# LEAVE OFF until the intake URL + secret are confirmed and the holyship fixture
# is synced into EmpireVu's intake fixtures. Every submission still builds +
# persists the envelope to empirevu_outbox regardless (replay via
# `bun scripts/replay-outbox.ts skipped_gated`).
#
# Off = leave URL/SECRET blank, OR set EMPIREVU_INTAKE_DISABLED=1 (kill switch).
EMPIREVU_INTAKE_URL=
EMPIREVU_INTAKE_SECRET=
EMPIREVU_INTAKE_DISABLED=1

# ─── App (SERVER-ONLY, optional) ─────────────────────────────────────────────
# Server-side site origin (falls back to VITE_SITE_URL).
SITE_URL=
# Build identifier reported by GET /api/health. Railway sets
# RAILWAY_GIT_COMMIT_SHA automatically; BUILD_SHA is an override.
BUILD_SHA=
