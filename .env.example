# boatnames.ca — environment variables.
# Copy to `.env` for local dev. NEVER commit real values.
#
# RULE: anything prefixed VITE_ is PUBLIC — Vite inlines it into the browser
# bundle. Secrets (service-role key, Resend key, EmpireVu secret, database URL)
# MUST NOT carry the VITE_ prefix.

# ─── Public (VITE_*) — shipped to the browser ────────────────────────────────
# Canonical site origin. Drives absolute OG images, the sitemap, and the
# shareable preview links. Defaults to https://boatnames.ca.
VITE_SITE_URL=
# Optional. If set, client-side errors are POSTed here ({message,stack,route,userAgent}).
VITE_ERROR_ENDPOINT=

# ─── Supabase (SERVER-ONLY) ──────────────────────────────────────────────────
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service-role key — bypasses RLS. Used ONLY by the /api/quote server route.
# SECRET. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Private Storage bucket for transom photos (default: quote-photos).
QUOTE_PHOTO_BUCKET=quote-photos

# ─── Outbound email — Resend (SERVER-ONLY) ───────────────────────────────────
# If unset, the lead is still saved; the notification is just skipped.
RESEND_API_KEY=
# From address (must be a Resend-verified domain — verify boatnames.ca before launch).
LEAD_FROM_EMAIL=leads@boatnames.ca
# Internal recipient of the lead notification.
LEAD_NOTIFY_EMAIL=hello@boatnames.ca

# ─── EmpireVu forward (SERVER-ONLY) — GATED OFF by default ───────────────────
# The signed lead forward to EmpireVu's /api/intake. boatnames.ca forwards as a
# new EmpireVu company (a1-boatnames under a1-group). LEAVE OFF until that company
# is seeded, the intake URL + secret are confirmed, and the boatnames fixtures are
# synced into EmpireVu's intake fixtures. Every submission still builds +
# persists the envelope to empirevu_outbox regardless (replay via
# `bun scripts/replay-outbox.ts skipped_gated`).
#
# Off = leave URL/SECRET blank, OR set EMPIREVU_INTAKE_DISABLED=1 (kill switch).
EMPIREVU_INTAKE_URL=
EMPIREVU_INTAKE_SECRET=
EMPIREVU_INTAKE_DISABLED=1

# ─── App (SERVER-ONLY, optional) ─────────────────────────────────────────────
# Server-side site origin (falls back to VITE_SITE_URL).
SITE_URL=
# Build identifier reported by GET /api/health. Railway sets
# RAILWAY_GIT_COMMIT_SHA automatically; BUILD_SHA is an override.
BUILD_SHA=

# ─── Checkout seam (Phase 8) — ALL SERVER-ONLY ───────────────────────────────
# Master switch. Everything below is inert unless "1". Default off. At launch,
# leave off (or unset) — the code defaults to off + manual, so Railway needs
# nothing here.
CHECKOUT_ENABLED=0

# Which pricing adapter resolves order amounts.
#   manual  = always returns unpriced; humans price via proof email (launch state)
#   engine  = a1-pricing-engine adapter (stub only in this phase — do not set)
PRICING_ADAPTER=manual

# Intended future provider, recorded for the decision doc.
#   stripe | shopify | none
PAYMENT_PROVIDER=none

# Reserved for the future Stripe integration. LEAVE UNSET now — boot validation
# tolerates their absence while CHECKOUT_ENABLED=0, and requires them the moment
# it is "1" with PAYMENT_PROVIDER=stripe.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_TAX_ENABLED=0

# Reserved for the Shopify fallback path. Same rule: leave unset.
# SHOPIFY_SHOP_DOMAIN=
# SHOPIFY_ADMIN_ACCESS_TOKEN=
# SHOPIFY_WEBHOOK_SECRET=

# Admin order endpoints auth. Required only when CHECKOUT_ENABLED=1.
# Generate: openssl rand -hex 32
ADMIN_API_TOKEN=
